opam-version: "2.0"
version: "0.2.0"
synopsis: "Manage Git repositories across multiple destinations"
description:
  "git-fleet is a Git extension for managing repositories across multiple Git hosts and push destinations."
maintainer: ["Braeden Sowinski <braeden@sowinski.dev>"]
authors: ["Braeden Sowinski"]
license: "MIT"
tags: ["git" "cli" "developer-tools"]
homepage: "https://github.com/SowinskiBraeden/git-fleet"
bug-reports: "https://github.com/SowinskiBraeden/git-fleet/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.16" & >= "3.16"}
  "cmdliner" {>= "1.3.0"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/SowinskiBraeden/git-fleet.git"
